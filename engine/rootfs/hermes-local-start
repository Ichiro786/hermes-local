#!/bin/bash
# Hermes Local: start the Hermes dashboard and its gateway (sessions, cron; API server optional).
# Run by the Android app inside proot as: /bin/bash /opt/hermes-local/bin/hermes-local-start
# Settings come from /root/.hermes-local/settings.env, written by the app (KEY=VALUE lines):
#   HL_HOST=127.0.0.1|0.0.0.0   HL_PORT=9119   HL_API_SERVER=0|1   HL_API_PORT=8642
# Prints HERMES_LOCAL_READY <url> once the dashboard answers, HERMES_LOCAL_FAILED <why> on failure.
set -u
export HOME=/root HERMES_HOME=/root/.hermes HERMES_RUNTIME_DIR=/opt/hermes/tools
export PATH=/opt/hermes-local/bin:/root/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
export LANG=${LANG:-C.UTF-8} PYTHONUNBUFFERED=1 TMPDIR=/tmp
export AGY_CLI_DISABLE_AUTO_UPDATE=true  # agy ignores =1 (antigravity-cli#1046); the engine is updated as a whole
[ -r /etc/ssl/certs/ca-certificates.crt ] && export SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt
STATE=/root/.hermes-local
mkdir -p "$STATE" "$HERMES_HOME" /tmp
HL_HOST=127.0.0.1 HL_PORT=9119 HL_API_SERVER=0 HL_API_PORT=8642
# shellcheck disable=SC1091
[ -f "$STATE/settings.env" ] && . "$STATE/settings.env"
case "$HL_HOST" in 127.0.0.1|0.0.0.0) ;; *) HL_HOST=127.0.0.1 ;; esac
[[ $HL_PORT =~ ^[0-9]+$ ]] || HL_PORT=9119
[[ $HL_API_PORT =~ ^[0-9]+$ ]] || HL_API_PORT=8642

# agy never updates itself: settings carried over from an older engine may lack update.mode, and an update
# that slipped through leaves a 250 MB agy.<n>.old next to the binary.
rm -f /usr/local/bin/agy.*.old /root/.local/bin/agy.*.old 2>/dev/null
agy_settings=/root/.gemini/antigravity-cli/settings.json
if ! grep -qs '"update.mode": *"none"' "$agy_settings"; then
  mkdir -p "${agy_settings%/*}"
  python3 - "$agy_settings" <<'PY' 2>/dev/null || printf '{\n  "update.mode": "none"\n}\n' >"$agy_settings"
import json, sys
p = sys.argv[1]
try: d = json.load(open(p))
except Exception: d = {}
d["update.mode"] = "none"
json.dump(d, open(p, "w"), indent=2)
PY
fi

[ -s /etc/machine-id ] || (cat /proc/sys/kernel/random/uuid 2>/dev/null || date +%s%N | sha256sum) | tr -d '-' | cut -c1-32 >/etc/machine-id

if ! hermes-local-passwd --check >/dev/null 2>&1; then
  echo "HERMES_LOCAL_FAILED no dashboard password set"
  exit 3
fi

# Voice defaults once per HERMES_HOME (cloud STT from the saved OpenAI/Gemini key, automatic language, Edge TTS;
# v2 also moves test3's local-Whisper setting over, the engine no longer ships Whisper): without an
# STT provider the apps' Live Mode gets HTTP 400 "No STT provider available" from /api/audio/transcribe.
if [ ! -e "$STATE/voice-defaults-v2" ]; then
  /bin/bash /opt/hermes-local/bin/hermes-local-voice defaults 2>&1 | sed -u 's/^/[hermes-local] voice defaults: /' | tail -n 3
fi

# On Android every app can reach 127.0.0.1, so the dashboard must never run in Hermes' unauthenticated
# loopback mode (where the SPA hands out a session token). A non-loopback public_url engages the
# password gate even on a loopback bind; a 0.0.0.0 bind engages it by itself.
if [ "$HL_HOST" = 127.0.0.1 ]; then
  export HERMES_DASHBOARD_PUBLIC_URL="http://hermes-local.lan:$HL_PORT"
fi

# pids[] holds the Hermes processes themselves (their output goes through process substitution), so a stop
# reaches Hermes (sessions flush) instead of only the log filters. killtree also covers launcher wrappers.
pids=()
killtree() { local c; for c in $(pgrep -P "$1" 2>/dev/null); do killtree "$c"; done; kill -TERM "$1" 2>/dev/null; }
cleanup() {
  trap - TERM INT HUP
  local p
  for p in "${pids[@]}"; do killtree "$p"; done
  for _ in $(seq 1 30); do
    local alive=0; for p in "${pids[@]}"; do kill -0 "$p" 2>/dev/null && alive=1; done
    [ "$alive" = 0 ] && break; sleep 0.2
  done
  exit "${1:-0}"
}
trap cleanup TERM INT HUP

# Terminal (official Hermes app) connects by SSH to 127.0.0.1:2222 as admin. Port 22 cannot
# bind inside proot on a non-rooted phone, so sshd listens on 2222; UsePAM=no avoids PAM (no
# systemd in proot) and password auth reads /etc/shadow directly. The admin password is kept
# in sync with the dashboard password by hermes-local-passwd. sshd runs in pids[] so it stops
# with the engine; an already-running sshd (started by hand) is left alone.
if [ -x /usr/sbin/sshd ]; then
  mkdir -p /run/sshd
  id admin 2>/dev/null || useradd -m -s /bin/bash admin
  [ -f /etc/ssh/ssh_host_ed25519_key ] || ssh-keygen -A >/dev/null 2>&1
  if ! pgrep -x sshd >/dev/null 2>&1; then
    /usr/sbin/sshd -D -p 2222 -o UsePAM=no -o PasswordAuthentication=yes -o PermitRootLogin=no > >(sed -u 's/^/[sshd] /') 2>&1 &
    pids+=($!)
  fi
fi

if [ -x /opt/hermes-local/bin/hermes-local-bridge ]; then
  /opt/hermes-local/bin/hermes-local-bridge > >(sed -u 's/^/[bridge] /') 2>&1 &
  pids+=($!)
fi

# Hermes v0.23.0's server dashboard relies on its own gateway: the gateway owns the session store
# (without it /api/sessions and /api/analytics answer 503 "Session store is not initialized") and runs
# the cron scheduler. It runs with no messaging platforms too; the API server only when enabled.
gw_env=()
if [ "$HL_API_SERVER" = 1 ]; then
  if [ ! -s "$STATE/api-key" ]; then
    (umask 077; head -c 32 /dev/urandom | base64 | tr -d '/+=\n' >"$STATE/api-key")
  fi
  gw_env=(API_SERVER_ENABLED=true API_SERVER_HOST="$HL_HOST" API_SERVER_PORT="$HL_API_PORT" API_SERVER_KEY="$(cat "$STATE/api-key")")
fi
env "${gw_env[@]}" hermes gateway run > >(sed -u 's/^/[gateway] /') 2>&1 &
pids+=($!)

hermes dashboard --host "$HL_HOST" --port "$HL_PORT" --no-open --skip-build > >(sed -u 's/^/[dashboard] /') 2>&1 &
dash=$!
pids+=("$dash")

ready=0
for _ in $(seq 1 600); do
  if curl -s -o /dev/null --max-time 2 "http://127.0.0.1:$HL_PORT/api/auth/providers"; then ready=1; break; fi
  kill -0 "$dash" 2>/dev/null || break
  sleep 0.5
done
# The gateway creates the session store on its first start; the apps open sessions right away.
if [ "$ready" = 1 ]; then
  for _ in $(seq 1 240); do [ -s "$HERMES_HOME/state.db" ] && break; sleep 0.5; done
  [ -s "$HERMES_HOME/state.db" ] || echo "[hermes-local] warning: session store not created yet (gateway still starting?)"
fi
if [ "$ready" = 1 ]; then
  echo "HERMES_LOCAL_READY http://127.0.0.1:$HL_PORT"
else
  echo "HERMES_LOCAL_FAILED dashboard did not answer on port $HL_PORT"
fi
wait "$dash"
cleanup $?
